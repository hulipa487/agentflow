---@meta
-- Editor stubs for the AgentFlow Lua API (LuaLS completion and hover). Never
-- executed. The prelude in internal/vm/prelude.go is the source of truth and
-- its version (af.version) is the compatibility contract; every chunk must
-- declare it in its leading comment block:
--
--   -- af-prelude-version: 1
--
-- The canonical copy lives in the runtime repo at api/luau/af.d.luau; Studio's
-- docs/luau/af.d.luau is synced from it with `make docs-sync`.

---@class MediaPart
---@field type string "text" | "image" | "audio" | "video" | "file"
---@field text? string
---@field mime? string
---@field data? string base64
---@field url? string
---@field handle? string "media:<sha256>" blob handle
---@field name? string
---@field size? integer byte length when known

---@class Provenance
---@field kind string "channel" | "agent" | "scheduler" | "system"
---@field principal string
---@field parent? string
---@field request_id? string use this, never a payload field, for agent.reply
---@field user_uuid? string the tenant; nil = unknown, "" = known to have none
---@field membership_uuid? string set when the turn acts in a group context

---@class Message
---@field id string
---@field type string "user" | "timer" | "agent" | "confirm" | "system" | ...
---@field from string
---@field to? string
---@field text? string
---@field channel? string
---@field reply_to? string
---@field attachments? MediaPart[]
---@field payload? table
---@field provenance? Provenance
---@field ts? integer

---@class ToolCall
---@field id? string
---@field name string
---@field args? table
---@field arguments? string the model's own argument JSON, when the provider sent it; session.reply sends it in preference to args (clear it on a call whose args you edit)

---@class Usage
---@field input integer
---@field output integer
---@field cached integer
---@field cache_write integer
---@field reasoning integer

---@class LLMReply
---@field text? string
---@field thinking? string
---@field thinking_blocks? table[] pass back on the assistant turn to continue Anthropic tool loops
---@field tool_calls? ToolCall[]
---@field media? MediaPart[] handle-only media outputs generated by the model
---@field usage? Usage

---@class Reply
---@field text? string
---@field tool_calls? ToolCall[]
---@field finish_reason? string "stop" | "tool_calls" | "length" | "content_filter"
---@field usage? Usage
---@field reasoning? string sent only by a channel configured to expose it; `thinking` (the name on an llm.forward or llm.chat result) is read when this is absent

---@class ForwardOpts
---@field model? string a models: key; default is the agent's model
---@field messages? ChatMessage[] replaces the client's messages
---@field prepend? ChatMessage[] turns added before the client's
---@field append? ChatMessage[] turns added after the client's
---@field tools? table[] adds tool definitions to the client's
---@field params? ChatOpts overrides sampling parameters
---@field max_tokens_cap? integer clamps the client's max_tokens

---@class ChatMessage
---@field role string "system" | "developer" | "user" | "assistant" | "tool"
---@field content? string
---@field parts? MediaPart[]
---@field tool_calls? ToolCall[]
---@field tool_call_id? string
---@field tool_result? any
---@field thinking_blocks? table[]

---@class ChatOpts
---@field model? string a key of `models:`; default is the agent's model
---@field temperature? number
---@field max_tokens? integer
---@field thinking? string "off" | "low" | "medium" | "high" | "xhigh" | "max"
---@field tools? table[] {name, description, parameters} or tools.list() entries
---@field tool_choice? string|{ name: string } "auto" | "none" | "required" | "function:<name>", or { name = "<name>" } for a named function
---@field parallel_tool_calls? boolean
---@field top_p? number
---@field stop? string|string[]
---@field seed? integer
---@field response_format? table {"type":"text"|"json_object"|"json_schema", ...}; providers with no equivalent refuse it

---@class MemoryStoreBinding
---@field backend string
---@field table string
---@field features string[]
---@field locality "deployment" | "region" | "instance" how far the store's data reaches: durable across the deployment, shared within the region, or lost with the process

---@class AgentInfo
---@field name string
---@field session_id string
---@field address string
---@field model string
---@field instructions? string base instructions plus the user's layer, if any
---@field history_budget? integer
---@field skills? string[]
---@field capabilities? string[]
---@field memory? { stores?: table<string, MemoryStoreBinding>, recall?: string, embed_model?: string }
---@field prompts? table<string, string>
---@field extras? table

---@class TimerRef
---@field id string

---@class af
---@field version integer the prelude API version this core implements
---@field op fun(req: table): any raw op call; prefer the typed helpers
af = {}

-- session -------------------------------------------------------------------

session = {}

--- Wait for the next inbound message. Parks the session.
---@return Message
function session.inbox() end

--- Reply to the active inbound message.
---@param text string
---@param opts? { attachments?: MediaPart[] }
function session.send(text, opts) end

--- Finish the turn with a structured assistant message. At most one per turn;
--- the text goes through the same safety and journal path as session.send.
--- On a channel that cannot express tool calls, a reply carrying them is
--- refused rather than silently reduced to its text.
---@param reply Reply
function session.reply(reply) end

--- Send one text fragment of the answer. The engine relays it live only when
--- the safety profile cannot veto the answer afterwards; otherwise it holds
--- the fragments and releases the checked whole at end of turn.
---@param text string
function session.send_delta(text) end

--- Proactive send to a channel recipient. Capability: channel.push.
---@param channel string
---@param reply_to string
---@param text string
---@param opts? { attachments?: MediaPart[] }
function session.push(channel, reply_to, text, opts) end

--- Proactive send to a user by identity UUID. Capability: channel.push.
---@param uuid string
---@param text string
function session.push_user(uuid, text) end

--- End this session permanently; the loop is never resumed.
function session.exit() end

session.state = {}

--- Capability: session.state. Values up to 64 KiB, 256 keys per session.
---@param key string
---@param value any
function session.state.set(key, value) end

---@param key string
---@return any value nil when never set
function session.state.get(key) end

---@param key string
function session.state.delete(key) end

---@return table<string, any>
function session.state.list() end

